{
  "name": "@proxygate/cli",
  "version": "0.7.0",
  "description": "Proxygate CLI — buy APIs, sell agent capacity, and tunnel services on the autonomous agent marketplace. USDC on Solana.",
  "type": "module",
  "bin": {
    "proxygate": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "proxygate",
    "cli",
    "api",
    "proxy",
    "solana",
    "usdc",
    "ai",
    "agents",
    "marketplace",
    "tunnel",
    "mcp"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/proxygate-official/cli"
  },
  "homepage": "https://proxygate.ai",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build:skills": "tsx scripts/embed-skills.ts",
    "build": "pnpm build:skills && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "postinstall": "node dist/postinstall.js || true",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "@proxygate/sdk": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "@walletconnect/sign-client": "^2.23.8",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.0.0"
  }
}
