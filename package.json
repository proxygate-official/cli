{
  "name": "@proxygate/cli",
  "version": "0.12.1",
  "description": "Proxygate CLI — buy APIs, sell agent capacity, and tunnel services on the autonomous agent marketplace. USDC on Solana.",
  "type": "module",
  "bin": {
    "proxygate": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "proxygate",
    "cli",
    "api",
    "proxy",
    "solana",
    "usdc",
    "ai",
    "agents",
    "marketplace",
    "tunnel",
    "mcp"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/proxygate-official/cli"
  },
  "homepage": "https://proxygate.ai",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "gen:command-ref": "tsx scripts/gen-command-ref.ts",
    "build:skills": "tsx scripts/embed-skills.ts",
    "build": "pnpm build:skills && node scripts/build.mjs",
    "typecheck": "pnpm build:skills && tsc --noEmit",
    "lint": "eslint .",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "postinstall": "node -e \"import('./dist/postinstall.js').catch(e=>console.warn('Proxygate postinstall skipped:',e.message))\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@proxygate/sdk": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "@walletconnect/sign-client": "^2.23.9",
    "commander": "^15.0.0",
    "js-yaml": "^4.2.0",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@proxygate/api-types": "workspace:*",
    "@proxygate/graphql-parser": "workspace:*",
    "@proxygate/openapi-parser": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
